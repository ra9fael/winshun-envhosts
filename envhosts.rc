#pragma code_page(65001)
#include <winver.h>

// The exe icon, drawn from Phosphor gear (U+E270) by winshun-plugin-icons.
// Window icons must explicitly load the string resource name IDI_ICON1.
// Use WM_SETICON for both sizes; custom captions must draw the icon.
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,7,5,0
 PRODUCTVERSION 0,7,5,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "环境变量 / hosts 编辑 · Win顺 插件"
            VALUE "FileVersion", "0.7.5"
            VALUE "InternalName", "envhosts"
            VALUE "OriginalFilename", "envhosts.exe"
            VALUE "ProductName", "Win顺 · WinShun"
            VALUE "ProductVersion", "0.7.5"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
